# OTG preflight L: compile host/HID while keeping the confirmed peripheral DT.
CONFIG_PM_OPP=y
CONFIG_QCOM_IPCC=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8250=y
# Selected by GCC; require its domain helper explicitly for verification.
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_PDC=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
# Selected helpers: verify them explicitly.
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
# Keep translated DMA and the upstream unmatched-stream policy explicit.
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y
# Mainline defaults this to y: disable next-page prefetch for MMU-500 errata.
CONFIG_ARM_SMMU_MMU_500_CPRE_ERRATA=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_GENERIC_PHY=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_GADGET is not set
CONFIG_USB_DWC3_QCOM=y

CONFIG_USB=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_CONFIGFS_FS=y
# USB host and HID keyboard.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y

# PM8150B attachment detection controls role and the 5 V source.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# USB mass storage only; internal UFS remains disabled.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# NTFS stick: pmos-load mounts this driver read-only, without force.
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y

# Userspace prerequisites selected from the local pmOS SM8250 reference.
# This is a console preflight, not full pmb:kconfigcheck-community compliance.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_USER_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
