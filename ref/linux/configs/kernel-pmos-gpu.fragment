# OTG preflight L: compile host/HID while keeping the confirmed peripheral DT.
CONFIG_PM_OPP=y
CONFIG_QCOM_IPCC=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SM_GCC_8250=y
# Selected by GCC; require its domain helper explicitly for verification.
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_PDC=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
# Selected helpers: verify them explicitly.
CONFIG_INTERCONNECT_QCOM_RPMH=y
CONFIG_INTERCONNECT_QCOM_BCM_VOTER=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
# Keep translated DMA and the upstream unmatched-stream policy explicit.
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y
# Mainline defaults this to y: disable next-page prefetch for MMU-500 errata.
CONFIG_ARM_SMMU_MMU_500_CPRE_ERRATA=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_GENERIC_PHY=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_GADGET is not set
CONFIG_USB_DWC3_QCOM=y

CONFIG_USB=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_CONFIGFS_FS=y
# USB host and HID keyboard.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT_EVDEV=y

# PM8150B attachment detection controls role and the 5 V source.
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# USB mass storage only; internal UFS remains disabled.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
CONFIG_EXT4_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# NTFS stick: pmos-load mounts this driver read-only, without force.
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y

# Userspace prerequisites selected from the local pmOS SM8250 reference.
# This is a console preflight, not full pmb:kconfigcheck-community compliance.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_USER_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# QCA6390: native PCIe, PMU sequencing and ath11k. Hardware test required.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SM8250=y
CONFIG_POWER_SEQUENCING=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_FW_LOADER=y
CONFIG_PACKET=y
CONFIG_RFKILL=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_NETDEVICES=y
CONFIG_PHY_QCOM_QMP=y

# QMP PCIe calls syscon lookup even when its optional DT property is absent.
CONFIG_MFD_SYSCON=y

# Expose framebuffer device/sysfs diagnostics in addition to fbcon.
CONFIG_FB_DEVICE=y

# Adreno 650 render-only experiment; keep inherited simplefb/DSI state.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
# CONFIG_DRM_MSM_MDP4 is not set
# CONFIG_DRM_MSM_MDP5 is not set
# CONFIG_DRM_MSM_DPU is not set
CONFIG_SM_GPUCC_8250=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_LLCC=y

# Type-C selects AUX_HPD_BRIDGE when DRM is enabled; bridge calls KMS helpers.
CONFIG_DRM_KMS_HELPER=y

# GPU devfreq and the governor explicitly requested by msm_devfreq_init().
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
# a6xx_gpu_init() requires UBWC data even for a render-only DRM device.
# DRM_MSM selects UBWC only when SMEM is available.
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_UBWC_CONFIG=y
