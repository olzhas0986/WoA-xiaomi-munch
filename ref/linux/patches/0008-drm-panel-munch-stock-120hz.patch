  if (!ctx->prepared)
   return 0;
+ if (ctx->refresh_rate == 120)
+  return l11r_send(ctx, l11r_off_120, ARRAY_SIZE(l11r_off_120));
  return l11r_send(ctx, l11r_off, ARRAY_SIZE(l11r_off));
 }
 
