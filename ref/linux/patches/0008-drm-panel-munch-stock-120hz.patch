 };
 
@@ -77,11 +80,14 @@
  msleep(12);
  gpiod_set_value_cansleep(ctx->reset, 0);
  msleep(10);
- ret = l11r_send(ctx, l11r_on, ARRAY_SIZE(l11r_on));
