#!/bin/sh
# Interactive WPA2/open-network onboarding inside the RAM rootfs.
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
fail() { echo "Wi-Fi: $*" >&2; exit 1; }
for cmd in iw ip wpa_supplicant wpa_cli udhcpc; do
 command -v "$cmd" >/dev/null || fail "missing $cmd; install iw wpa_supplicant and a DHCP client"
done
iface=$(iw dev | awk '$1 == "Interface" {print $2; exit}')
[ -n "$iface" ] || fail 'no Wi-Fi interface'
ip link set "$iface" up
mkdir -p /run/wpa_supplicant
umask 077
if ! wpa_cli -i "$iface" ping 2>/dev/null | grep -q PONG; then
 printf 'ctrl_interface=/run/wpa_supplicant\nupdate_config=0\n' > /run/pmos-munch-wifi.conf
 wpa_supplicant -B -i "$iface" -c /run/pmos-munch-wifi.conf > /run/pmos-munch-wpa.log 2>&1 || {
  cat /run/pmos-munch-wpa.log >&2
  fail "cannot start wpa_supplicant"
 }
fi
password=
network=
success=0
cleanup() {
 stty echo 2>/dev/null || :
 password=
 if [ "$success" = 0 ] && [ -n "$network" ]; then
  wpa_cli -i "$iface" remove_network "$network" >/dev/null 2>&1 || :
 fi
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM
while :; do
 wpa_cli -i "$iface" scan >/dev/null
 sleep 4
 wpa_cli -i "$iface" scan_results | awk -F '\t' 'length($1)==17 && substr($1,3,1)==":" && NF>=5 && length($5)>0' > /run/pmos-munch-wifi.scan
 echo 'Available Wi-Fi networks:'
 awk -F '\t' '{printf "%3d) %s  signal=%s  %s\n",NR,$5,$3,$4}' /run/pmos-munch-wifi.scan
 echo 'r) Rescan    0) Skip Wi-Fi and enter pmOS'
 printf 'Choose network number: '
 IFS= read -r choice || exit 1
 case "$choice" in 0) success=1; exit 0;; r|R) continue;; ''|*[!0-9]*) echo 'Enter a number or r.'; continue;; esac
 row=$(awk -v n="$choice" 'NR==n' /run/pmos-munch-wifi.scan)
 [ -n "$row" ] || { echo 'No such network.'; continue; }
 flags=$(printf '%s\n' "$row" | cut -f4)
 escaped=$(printf '%s\n' "$row" | cut -f5)
 ssid=$(printf '%b' "$escaped")
 ssid_hex=$(printf '%s' "$ssid" | od -An -tx1 | tr -d ' \n')
 [ -n "$ssid_hex" ] || continue
 case "$flags" in
  *PSK*)
   printf 'Password (hidden): '
   stty -echo
   IFS= read -r password || exit 1
   stty echo; printf '\n'
   bytes=$(printf '%s' "$password" | wc -c | tr -d ' ')
   if [ "$bytes" -ge 8 ] && [ "$bytes" -le 63 ]; then
    # wpa_cli parses a quoted WPA passphrase; escape its two special bytes.
    escaped_password=$(printf '%s' "$password" | sed 's/\\/\\\\/g; s/"/\\"/g')
    psk="\"$escaped_password\""
    escaped_password=
   elif [ "$bytes" = 64 ] && ! printf '%s' "$password" | grep -q '[^0-9a-fA-F]'; then
    psk=$password
   else
    password=
    echo 'Use 8–63 bytes for a WPA password, or a 64-digit hexadecimal PSK.'
    continue
   fi
   password=
   ;;
  *WEP*|*WPA*|*SAE*|*EAP*) echo 'This security mode needs manual configuration (WPA2-PSK or open supported).'; continue;;
  *) psk=;;
 esac
 network=$(wpa_cli -i "$iface" add_network | awk '/^[0-9]+$/ {print; exit}')
 [ -n "$network" ] || fail 'cannot create supplicant network'
 wpa_cli -i "$iface" set_network "$network" ssid "$ssid_hex" | grep -q '^OK$' || fail 'SSID rejected'
 # Some hotspots omit their SSID in beacons; probe the selected name directly.
 wpa_cli -i "$iface" set_network "$network" scan_ssid 1 | grep -q '^OK$' || fail 'directed scan rejected'
 if [ -n "$psk" ]; then
  # Send credentials through stdin only; never command arguments or files.
  control=$(printf 'set_network %s psk %s\nquit\n' "$network" "$psk" | wpa_cli -i "$iface")
  printf '%s\n' "$control" | grep -Eq '(^|> )OK$' || fail 'PSK rejected'
  control=
  psk=
 else
  wpa_cli -i "$iface" set_network "$network" key_mgmt NONE | grep -q '^OK$' || fail 'open network rejected'
 fi
 wpa_cli -i "$iface" select_network "$network" >/dev/null
 echo 'Connecting...'
 n=0; connected=0
 while [ "$n" -lt 25 ]; do
  if wpa_cli -i "$iface" status | grep -q '^wpa_state=COMPLETED$'; then connected=1; break; fi
  sleep 1; n=$((n+1))
 done
 if [ "$connected" = 1 ]; then
  if udhcpc -i "$iface" -n -q -t 5; then
   success=1
   echo 'Wi-Fi connected. Entering pmOS shell.'
   exit 0
  fi
  echo 'DHCP failed; select another network or skip.'
 else
  state=$(wpa_cli -i "$iface" status | sed -n 's/^wpa_state=//p')
  echo "Connection did not complete (state: ${state:-unknown}); inspect the supplicant log."
 fi
 wpa_cli -i "$iface" remove_network "$network" >/dev/null
 network=
done
