#!/bin/sh
# Save only the current RAM rootfs to verified USB storage; no internal disks.
set -eu
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
fail() { echo "pmos-save: $*" >&2; exit 1; }
worker=0
if [ "${1:-}" = --worker ]; then worker=1; shift; fi
[ "$#" -le 1 ] || fail 'usage: pmos-save-current [/dev/sda1]'
device=${1:-/dev/sda1}
case "$device" in /dev/sd[a-z]|/dev/sd[a-z][1-9]|/dev/sd[a-z][1-9][0-9]) ;; *) fail 'expected USB sd disk/partition';; esac
[ -f /.pmos-munch-ready ] || fail 'run inside the loaded pmOS RAM rootfs'
grep -q '^[^ ]* / tmpfs ' /proc/mounts || fail 'not the expected RAM rootfs'
if [ "$worker" = 0 ]; then
 mkdir /run/pmos-save.lock 2>/dev/null || fail 'save is already running'
 self=$(readlink -f "$0")
 setsid /bin/sh "$self" --worker "$device" </dev/null >/tmp/pmos-save.log 2>&1 &
 echo 'Save scheduled. Attach OTG + NTFS USB within 10 seconds.'
 echo 'Progress: /tmp/pmos-save.log. Wait for PMOS SAVED before unplugging.'
 exit 0
fi
mounted=0
cleanup() {
 result=$?
 trap - 0
 if [ "$mounted" = 1 ]; then
  sync
  umount /mnt/pmos-save || { echo 'Unmount failed; do not unplug USB'; result=1; }
 fi
 echo "Save exit status: $result"
 rmdir /run/pmos-save.lock 2>/dev/null || :
 exit "$result"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' TERM
echo 'Connect OTG + NTFS USB now. Waiting 10 seconds...'
sleep 10
pidof apk >/dev/null && fail 'finish package installation first'
name=${device##*/}
# A partition's canonical sysfs ancestry includes the USB interface, regardless
# of hub depth or the SCSI transport's directory layout.
is_usb_block() {
 path=$(readlink -f "/sys/class/block/$name") || return 1
 case "$path" in /sys/devices/*) ;; *) return 1;; esac
 while [ "$path" != /sys/devices ] && [ "$path" != / ]; do
  subsystem=$(readlink -f "$path/subsystem" 2>/dev/null || :)
  [ "$subsystem" != /sys/bus/usb ] || return 0
  path=${path%/*}
 done
 return 1
}
# OTG role switching and enumeration may finish after the initial countdown.
n=0
while ! { [ -b "$device" ] && is_usb_block; }; do
 [ "$n" -lt 20 ] || fail "$device is absent or has no verified USB ancestor; inspect ls /sys/class/block and readlink -f /sys/class/block/$name"
 sleep 1
 n=$((n+1))
done
grep -q "^$device " /proc/mounts && fail 'USB partition is already mounted'
mkdir -p /mnt/pmos-save
mountpoint -q /mnt/pmos-save && fail 'save directory is already mounted'
mount -t ntfs3 -o rw,nosuid,nodev,noexec "$device" /mnt/pmos-save || fail 'NTFS mount failed; no force option used'
mounted=1
cd /mnt/pmos-save
base=postmarketos-desktop.tar.gz
[ ! -e "$base.partial" ] && [ ! -e "$base.sha256.partial" ] || fail 'partial save exists; inspect it before retrying'
echo 'Archiving RAM rootfs; do not remove USB...'
# GNU and BusyBox tar both support these exclusions. No live mount trees.
(set -C; tar -czpf - -C / --exclude=./dev --exclude=./proc --exclude=./sys \
 --exclude=./run --exclude=./tmp --exclude=./mnt --exclude=./media \
 --exclude=./.pmos-munch-ready . > "$base.partial") || fail 'tar failed; partial file retained'
digest=$(sha256sum "$base.partial"); digest=${digest%% *}
printf '%s  %s\n' "$digest" "$base" > "$base.sha256.partial"
sync
if [ -e "$base" ] || [ -e "$base.sha256" ]; then
 n=1
 while [ -e "postmarketos-desktop.previous-$n.tar.gz" ] || [ -e "postmarketos-desktop.previous-$n.tar.gz.sha256" ]; do n=$((n+1)); done
 [ ! -e "$base" ] || mv "$base" "postmarketos-desktop.previous-$n.tar.gz"
 if [ -e "$base.sha256" ]; then
  old_digest=$(awk 'NR==1 {print $1}' "$base.sha256")
  printf '%s  postmarketos-desktop.previous-%s.tar.gz\n' "$old_digest" "$n" > "postmarketos-desktop.previous-$n.tar.gz.sha256"
  rm "$base.sha256"
 fi
fi
mv "$base.partial" "$base"
mv "$base.sha256.partial" "$base.sha256"
sync
cd /
umount /mnt/pmos-save || fail 'unmount failed; do not unplug USB'
mounted=0
echo 'PMOS SAVED. USB unmounted; safe to disconnect.'
echo 'Desktop archive and SHA256 ready. Previous archives preserved.'
