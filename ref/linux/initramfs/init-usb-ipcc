#!/bin/busybox sh
export PATH=/bin:/sbin
/bin/busybox --install -s /bin
exec 0</dev/console 1>/dev/console 2>&1
fatal() { echo "init: FAILED: $*"; exec sh; }
mount -t devtmpfs devtmpfs /dev || fatal 'mount /dev'
mount -t proc proc /proc || fatal 'mount /proc'
mount -t sysfs sysfs /sys || fatal 'mount /sys'
log() { echo "init: $*"; echo "init: $*" > /dev/kmsg; }
log 'userspace alive: USB preflight B (IPCC mailbox)'
uname -a
printf 'online CPUs: '; cat /sys/devices/system/cpu/online
printf 'CPU count: '; grep -c '^processor' /proc/cpuinfo
cat /proc/meminfo
printf 'cmdline: '; cat /proc/cmdline
dmesg > /run/dmesg.boot || fatal 'save dmesg'
# Keep the result on screen; no gadget, regulator/clock-controller or PHY driver.
echo '=== USB PREFLIGHT B: IPCC / AOSS ==='
for spec in qcom-rpmhpd:rpmhpd qcom-ipcc:ipcc qcom_aoss_qmp:aoss; do
 driver=${spec%%:*}
 label=${spec#*:}
 bound=no
 for device in /sys/bus/platform/drivers/"$driver"/*; do
  if [ -d "$device" ] && [ -e "$device/of_node" ]; then
   echo "$label bound: ${device##*/}"
   bound=yes
  fi
 done
 echo "$label provider bound: $bound"
done
echo '=== relevant kernel messages (last 12) ==='
dmesg | grep -iE 'rpmh|rsc:|OPP table|aoss|ipcc|ipc mailbox|qmp|power-controller' | tail -n 12
log 'preflight done; dmesg saved in /run/dmesg.boot; starting local shell'
# No USB gadget or storage writes. Without an input transport this is output only.
while true; do
 setsid cttyhack sh
 log 'shell exited; restarting'
 sleep 1
done
