  dmesg > /run/dmesg.otg
 done
) &
echo 'R: Run pmos-load, then attach NTFS stick within 10 seconds.'
echo 'S: pmos-load prepares GPU/Wi-Fi, offers network selection, then opens pmOS.'
echo 'P: Kernel config: zcat /proc/config.gz'
printf 'P CPUs: '; cat /sys/devices/system/cpu/online
printf 'P cgroups:\n'; cat /proc/cgroups
printf 'P inotify watches: '; cat /proc/sys/fs/inotify/max_user_watches
export PS1='munch# '

while true; do
 if [ -f /run/pmos-onboard.ready ]; then
  rm /run/pmos-onboard.ready
  setsid cttyhack /bin/pmos-onboard
 fi
 setsid cttyhack sh </dev/console >/dev/console 2>&1 &
 local_shell=$!
 echo "$local_shell" > /run/local-shell.pid
 wait "$local_shell" || :
 echo 'K: shell exited; restarting'
 sleep 1
done
