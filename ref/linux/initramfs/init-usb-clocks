#!/bin/busybox sh
export PATH=/bin:/sbin
/bin/busybox --install -s /bin
exec 0</dev/console 1>/dev/console 2>&1
fatal() { echo "C FAIL: $*"; exec sh; }
mount -t devtmpfs devtmpfs /dev || fatal DEV
mount -t proc proc /proc || fatal PROC
mount -t sysfs sysfs /sys || fatal SYS
# Full logs stay in RAM. The screen needs only a few transcribable fields.
echo 'init: userspace alive: USB preflight C' > /dev/kmsg
bound() {
 for device in /sys/bus/platform/drivers/"$1"/*; do
  if [ -d "$device" ] && [ -e "$device/of_node" ]; then
   echo 1
   return
  fi
 done
 echo 0
}
cpu=$(grep -c '^processor' /proc/cpuinfo)
rpmh=$(bound qcom-rpmhpd)
ipcc=$(bound qcom-ipcc)
aoss=$(bound qcom_aoss_qmp)
rpmhcc=$(bound clk-rpmh)
gcc=$(bound gcc-sm8250)
dmesg > /run/dmesg.boot || fatal DMESG
if [ "$rpmhcc" = 0 ]; then
 echo 'Clock diagnostics (last 5 matching messages):'
 dmesg | grep -iE 'clk-rpmh|clock-controller|missing RPMh|RPMh aux|register.*clock' | tail -n 5
fi
# No terminal clear: preserve preceding errors. No delayed scrolling or paging.
printf '\n=== USB PREFLIGHT C ===\n'
printf 'C CPU=%s RPMH=%s IPCC=%s AOSS=%s CLK=%s GCC=%s\n' \
 "$cpu" "$rpmh" "$ipcc" "$aoss" "$rpmhcc" "$gcc"
echo 'Expected: CPU=8 RPMH=1 IPCC=1 AOSS=1 CLK=1 GCC=0'
echo 'Copy the C line. Full log: /run/dmesg.boot'
while true; do
 setsid cttyhack sh
 echo 'C: shell exited; restarting'
 sleep 1
done
